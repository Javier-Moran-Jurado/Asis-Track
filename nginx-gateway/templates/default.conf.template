server {
    listen ${NGINX_PORT};
    server_name localhost;

    # ── Tamaño máximo de body para subir archivos (imágenes, PDFs, ZIPs) ──
    client_max_body_size 50M;

    # ── Manejo Global de CORS ──
    # Extraer el origen dinámicamente
    set $cors_origin "*";
    if ($http_origin ~* (.*)) {
        set $cors_origin $1;
    }

    # Ocultar headers CORS del upstream (Spring Boot) para evitar duplicados
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Credentials;

    # Añadir headers CORS "always" para que apliquen incluso en errores 502/504
    add_header 'Access-Control-Allow-Origin' '$cors_origin' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
    add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,ngrok-skip-browser-warning' always;

    # Responder localmente a las solicitudes preflight (OPTIONS)
    if ($request_method = 'OPTIONS') {
        add_header 'Access-Control-Allow-Origin' '$cors_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
        add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With,ngrok-skip-browser-warning' always;
        add_header 'Access-Control-Max-Age' 1728000;
        add_header 'Content-Type' 'text/plain; charset=utf-8';
        add_header 'Content-Length' 0;
        return 204;
    }

    # ── Auth / Usuario Service ──
    location /api/v1/auth/ {
        proxy_pass http://${UPSTREAM_USUARIO}/api/v1/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/usuario-service/ {
        proxy_pass http://${UPSTREAM_USUARIO}/api/v1/usuario-service/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Planilla Service ──
    # Timeouts altos porque la digitalización usa IA y puede tardar minutos
    location /api/v1/planilla-service/ {
        proxy_pass http://${UPSTREAM_PLANILLA}/api/v1/planilla-service/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts al máximo para llamadas de IA/OCR de larga duración
        # Railway corta la conexión ~10 min, por eso 600s es el techo real.
        proxy_connect_timeout 600s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;

        # Buffers para respuestas grandes
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }

    # ── Seguridad Service: SOLO llave pública ──
    # Las rutas /private, /rotate y /private/{id} NUNCA pasan por el gateway.
    # Los microservicios las consumen directamente por red interna.
    location /api/v1/security/keys/public {
        proxy_pass http://${UPSTREAM_SEGURIDAD}/api/v1/security/keys/public;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
